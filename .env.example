# Copy to .env and replace every placeholder before starting the stack.
APP_ENV=local
LOG_LEVEL=INFO
POSTGRES_DB=retailflow_orders
POSTGRES_USER=retailflow
POSTGRES_PASSWORD=replace-me-for-local-development
DATABASE_URL=postgresql+asyncpg://retailflow:replace-me-for-local-development@postgres:5432/retailflow_orders
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ORDER_EVENTS_TOPIC=retailflow.order-events.v1
INVENTORY_BASE_URL=http://inventory-stub:8090
INVENTORY_SERVICE_TOKEN=replace-with-local-inventory-service-token
JWT_SECRET=replace-with-at-least-64-random-characters-before-running
ADMIN_EMAIL=admin@retailflow.local
ADMIN_PASSWORD=replace-me-for-local-development
